    "expect": { "result": "OutbidByProxy", "priceC": 10250, "leader": "B", "leaderMaxC": 20000, "bidCount": 4, "outbid": null,
                "rows": [ { "user": "A", "amountC": 10000, "kind": "AutoOutbid" }, { "user": "B", "amountC": 10250, "kind": "ProxyAuto" } ] }
  },
  {
    "name": "flat table below min next",
    "inc": "0:500",
    "state": { "priceC": 1000, "leader": "A", "leaderMaxC": 2000, "bidCount": 1, "startC": 1000 },
    "user": "B", "maxC": 1400,
    "expect": { "error": "BELOW_MINIMUM", "minNextC": 1500 }
  },
  {
    "name": "flat table proxy answer",
    "inc": "0:500",
    "state": { "priceC": 1000, "leader": "A", "leaderMaxC": 2000, "bidCount": 1, "startC": 1000 },
    "user": "B", "maxC": 1700,
    "expect": { "result": "OutbidByProxy", "priceC": 2000, "leader": "A", "leaderMaxC": 2000, "bidCount": 2, "outbid": null,
                "rows": [ { "user": "B", "amountC": 1700, "kind": "AutoOutbid" }, { "user": "A", "amountC": 2000, "kind": "ProxyAuto" } ] }
  }
]

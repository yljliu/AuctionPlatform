<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="_content/MudBlazor/MudBlazor.min.css" />
    <link rel="stylesheet" href="app.css" />
    <title>Auction</title>
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <Routes @rendermode="PageRenderMode" />

    @* Shown by Blazor while the page connection is down (spec 04 task 8). It covers the page, so no bid can be clicked. *@
    <div id="components-reconnect-modal" class="reconnect-modal" aria-live="assertive">
        <div class="reconnect-banner" role="alert">
            <span class="reconnect-trying">Reconnecting&hellip; bidding paused</span>
            <span class="reconnect-lost">Connection lost. <a href="" id="components-reconnect-reload">Reload the page</a></span>
        </div>
    </div>

    <script src="_framework/blazor.web.js" autostart="false"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script src="js/clock.js"></script>
    <script src="js/reconnect.js"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // Account pages are plain server pages (no live connection), so they can set the sign-in cookie.
    // Every other page is interactive.
    private IComponentRenderMode? PageRenderMode =>
        HttpContext.Request.Path.StartsWithSegments("/account") ? null : InteractiveServer;
}

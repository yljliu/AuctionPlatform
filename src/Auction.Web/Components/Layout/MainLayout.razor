@inherits LayoutComponentBase
@inject IConfiguration Config

@* Spec 06 task 1: one layout for every interactive page. Providers here (design 1). *@
<MudThemeProvider Theme="_theme" @bind-IsDarkMode="_dark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <AppBar DarkMode="_dark" DarkModeChanged="v => _dark = v" />

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="mt-6 mb-12">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@* Shows which web copy served this page (R1.2, and the sticky-session check). *@
<footer class="instance-badge" id="instance-badge" title="Web copy that served this page">@Instance</footer>

<div id="blazor-error-ui">
    An error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">✕</a>
</div>

@code {
    private bool _dark;

    // Default MudBlazor theme with one primary colour (design 7).
    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight { Primary = "#1565c0" },
        PaletteDark = new PaletteDark { Primary = "#64b5f6" },
    };

    private string Instance => Config["INSTANCE_NAME"] ?? Environment.MachineName;
}

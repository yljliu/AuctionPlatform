@* A yes/no question (used for the 3x bid check, R3.4). *@
<MudDialog>
    <TitleContent><MudText Typo="Typo.h6">@Title</MudText></TitleContent>
    <DialogContent><MudText id="confirm-text">@Text</MudText></DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()" id="confirm-no">@NoText</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="() => MudDialog.Close(DialogResult.Ok(true))" id="confirm-yes">@YesText</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private MudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public string Title { get; set; } = "Are you sure?";

    [Parameter]
    public string Text { get; set; } = "";

    [Parameter]
    public string YesText { get; set; } = "Yes";

    [Parameter]
    public string NoText { get; set; } = "No";
}

@* Asks for a reason before an admin or seller action (R6.1, R6.2). Returns the reason, or cancels. *@
<MudDialog>
    <TitleContent><MudText Typo="Typo.h6">@Title</MudText></TitleContent>
    <DialogContent>
        @if (!string.IsNullOrEmpty(Prompt))
        {
            <MudText Class="mb-3">@Prompt</MudText>
        }
        <MudTextField T="string" @bind-Value="_reason" Label="Reason" Lines="3" MaxLength="400" Counter="400"
                      Required="true" RequiredError="Enter a reason." id="reason-text" AutoFocus="true" />
        @if (AskUntil)
        {
            <MudDatePicker Label="Suspended until" @bind-Date="_until" MinDate="DateTime.Today.AddDays(1)" Class="mt-3" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()">Back</MudButton>
        <MudButton Color="@ConfirmColor" Variant="Variant.Filled" Disabled="@(!CanConfirm)" OnClick="Confirm" id="reason-confirm">@ConfirmText</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private MudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public string Title { get; set; } = "Give a reason";

    [Parameter]
    public string? Prompt { get; set; }

    [Parameter]
    public string ConfirmText { get; set; } = "Confirm";

    [Parameter]
    public Color ConfirmColor { get; set; } = Color.Error;

    /// <summary>Also ask for an end date (suspend).</summary>
    [Parameter]
    public bool AskUntil { get; set; }

    private string _reason = "";
    private DateTime? _until = DateTime.Today.AddDays(7);

    private bool CanConfirm => _reason.Trim().Length is > 0 and <= 400 && (!AskUntil || _until != null);

    private void Confirm() => MudDialog.Close(DialogResult.Ok(new ReasonResult(_reason.Trim(), _until)));

    public sealed record ReasonResult(string Reason, DateTime? Until);
}

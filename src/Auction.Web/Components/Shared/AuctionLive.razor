@* Follows one auction's live feed (spec 04 task 6) and hands each new view to its content.
   Shares one Api stream per auction with every other viewer on this web copy.
   Redraws at most 10 times a second; Changed gets the view before and after each redraw (spec 06 task 5). *@
@using Auction.Web.Services.Live
@implements IDisposable
@inject LiveAuctionHub Hub
@inject TimeProvider Clock

<div id="@(ShowStatus ? "live-panel" : null)" data-feed="@_shown.Status">
    @if (ShowStatus && _shown.Status == LiveFeedStatus.Reconnecting)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-3" id="live-reconnecting" Icon="@Icons.Material.Filled.WifiOff">Reconnecting… bidding paused</MudAlert>
    }

    @if (!_shown.View.HasSnapshot)
    {
        @if (Fallback != null)
        {
            @Fallback
        }
        else
        {
            <MudProgressCircular Indeterminate="true" Size="Size.Small" />
        }
    }
    else if (ChildContent != null)
    {
        @ChildContent(_shown)
    }
</div>

@code {
    [Parameter, EditorRequired]
    public Guid AuctionId { get; set; }

    /// <summary>Show the reconnect alert (and the page ids). Off for a second copy on the same page.</summary>
    [Parameter]
    public bool ShowStatus { get; set; } = true;

    /// <summary>What to show for the live view.</summary>
    [Parameter]
    public RenderFragment<LiveFeedUpdate>? ChildContent { get; set; }

    /// <summary>Shown until the first snapshot arrives (for example the price from the page load).</summary>
    [Parameter]
    public RenderFragment? Fallback { get; set; }

    /// <summary>Called on the page's thread after each redraw-worthy change: (before, after).</summary>
    [Parameter]
    public EventCallback<(LiveFeedUpdate Before, LiveFeedUpdate After)> Changed { get; set; }

    private LiveWatch? _watch;
    private RenderThrottle? _throttle;
    private LiveFeedUpdate _latest = new(LiveAuctionView.Empty(Guid.Empty), LiveFeedStatus.Connecting);
    private LiveFeedUpdate _shown = new(LiveAuctionView.Empty(Guid.Empty), LiveFeedStatus.Connecting);

    protected override void OnInitialized()
    {
        _throttle = new RenderThrottle(RenderThrottle.Default, Clock, () => InvokeAsync(ShowLatestAsync));
        _watch = Hub.Watch(AuctionId, OnUpdate);
        _latest = _shown = _watch.Current;
    }

    // Runs on the feed's thread: keep the newest view and ask for a redraw.
    private void OnUpdate(LiveFeedUpdate update)
    {
        _latest = update;
        _throttle?.MarkDirty();
    }

    private async Task ShowLatestAsync()
    {
        var before = _shown;
        _shown = _latest;
        if (Changed.HasDelegate)
        {
            await Changed.InvokeAsync((before, _shown));   // re-renders the parent, and so this content
        }
        else
        {
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        _watch?.Dispose();
        _throttle?.Dispose();
    }
}

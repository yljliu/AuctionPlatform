@page "/account/login"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using Auction.Contracts.Errors
@inject AuthService.AuthServiceClient Auth
@inject ITokenSessionStore Sessions
@inject NavigationManager Navigation
@inject Auction.Web.Services.Ui.DemoOptions Demo

<PageTitle>Log in</PageTitle>

<MudPaper Class="pa-6 mx-auto" MaxWidth="420px">
    <MudText Typo="Typo.h5" GutterBottom="true">Log in</MudText>

    @if (Registered)
    {
        <MudAlert Severity="Severity.Success" Class="mb-4">Account created. You can log in now.</MudAlert>
    }
    @if (_error != null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4" id="login-error">@_error</MudAlert>
    }

    <EditForm Model="Input" method="post" OnValidSubmit="LogInAsync" FormName="login">
        <DataAnnotationsValidator />
        <div class="field">
            <label for="email">Email</label>
            <InputText id="email" type="email" @bind-Value="Input.Email" autocomplete="username" class="input" />
            <ValidationMessage For="() => Input.Email" />
        </div>
        <div class="field">
            <label for="password">Password</label>
            <InputText id="password" type="password" @bind-Value="Input.Password" autocomplete="current-password" class="input" />
            <ValidationMessage For="() => Input.Password" />
        </div>
        <button type="submit" class="mud-button-root mud-button mud-button-filled mud-button-filled-primary mud-ripple mt-2">Log in</button>
    </EditForm>

    @if (Demo.QuickLoginOn)
    {
        @* Demo only (R7.1). The form sends a user name; the password stays on the server. *@
        <MudDivider Class="my-4" />
        <EditForm Model="Quick" method="post" OnValidSubmit="QuickLogInAsync" FormName="quick">
            <div class="field">
                <label for="quick-user">Quick login (demo users)</label>
                <InputSelect id="quick-user" @bind-Value="Quick.User" class="input">
                    @foreach (var user in Demo.Users)
                    {
                        <option value="@user">@user</option>
                    }
                </InputSelect>
            </div>
            <button type="submit" id="quick-login" class="mud-button-root mud-button mud-button-outlined mud-button-outlined-primary mud-ripple">Log in as this user</button>
        </EditForm>
    }

    <MudText Class="mt-4">No account? <a href="/account/register">Register</a></MudText>
</MudPaper>

@code {
    // Null when Blazor opened this page as a live (interactive) page, for example after clicking
    // "Log in" in the top bar. The sign-in cookie can only be set on a normal page load.
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [SupplyParameterFromForm]
    private LoginInput Input { get; set; } = new();

    [SupplyParameterFromForm(FormName = "quick")]
    private QuickInput Quick { get; set; } = new();

    protected override void OnInitialized()
    {
        if (HttpContext is null)
        {
            // Load the page again as a normal server page.
            Navigation.Refresh(forceReload: true);
        }
    }

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "registered")]
    private bool Registered { get; set; }

    private string? _error;

    private Task LogInAsync() => SignInAsync(Input.Email, Input.Password);

    private Task QuickLogInAsync() =>
        Demo.QuickLoginOn && Demo.Users.Contains(Quick.User)
            ? SignInAsync(Auction.Web.Services.Ui.DemoOptions.EmailOf(Quick.User), Demo.Password)
            : Task.CompletedTask;

    private async Task SignInAsync(string email, string password)
    {
        if (HttpContext is null)
        {
            return;   // the reload above is on its way
        }

        LoginResponse reply;
        try
        {
            reply = await Auth.LoginAsync(
                new LoginRequest { Email = email, Password = password },
                headers: AccountEndpoints.ClientHeaders(HttpContext));
        }
        catch (Grpc.Core.RpcException ex)
        {
            _error = Auction.Web.Services.Ui.UiError.From(ex).Text;   // with "Ref: ..." (R8.1)
            return;
        }

        var session = TokenSession.From(reply.Tokens);
        var sessionId = await Sessions.CreateAsync(session);

        await HttpContext.SignInAsync(
            CookieAuthenticationDefaults.AuthenticationScheme,
            AccountEndpoints.BuildPrincipal(reply.Me, sessionId),
            new AuthenticationProperties { IsPersistent = true, ExpiresUtc = session.RefreshExpiresAt });

        Navigation.NavigateTo(AccountEndpoints.SafeReturnUrl(ReturnUrl), forceLoad: true);
    }

    private sealed class QuickInput
    {
        public string User { get; set; } = "alice";
    }

    private sealed class LoginInput
    {
        [Required, EmailAddress]
        public string Email { get; set; } = "";

        [Required]
        public string Password { get; set; } = "";
    }
}

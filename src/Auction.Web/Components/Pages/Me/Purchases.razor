@page "/me/purchases"
@attribute [Authorize]
@using Auction.Web.Services.Ui
@inject BiddingService.BiddingServiceClient Bidding
@inject TimeProvider Clock

@* Spec 06 task 7 (R4.3) and spec 10 (R4.1, R4.5, R5.7): won auctions, what you owe, and Pay or the receipt. *@
<PageTitle>Purchases · Auction</PageTitle>

<MudText Typo="Typo.h5" GutterBottom="true">Purchases</MudText>

@if (_error != null)
{
    <MudAlert Severity="Severity.Error" Class="mb-3">@_error.Text</MudAlert>
}

<MudTable T="SettlementRow" Items="_rows" Loading="_loading" Dense="true" Hover="true" id="purchases">
    <HeaderContent>
        <MudTh>Item</MudTh><MudTh>Price</MudTh><MudTh>Premium</MudTh><MudTh>Shipping</MudTh><MudTh>Total due</MudTh>
        <MudTh>Pay by</MudTh><MudTh>Status</MudTh><MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Item"><MudLink Href="@($"/a/{context.Auction.AuctionId}")">@context.Auction.Title</MudLink></MudTd>
        <MudTd DataLabel="Price">@UiFormat.Money(context.HammerPrice)</MudTd>
        <MudTd DataLabel="Premium">@UiFormat.Money(context.BuyerPremium)</MudTd>
        <MudTd DataLabel="Shipping">@UiFormat.Money(context.ShippingCost)</MudTd>
        <MudTd DataLabel="Total due"><b>@UiFormat.Money(context.TotalDue)</b></MudTd>
        <MudTd DataLabel="Pay by">@UiFormat.LocalTime(context.PaymentDeadlineMs) UTC</MudTd>
        <MudTd DataLabel="Status">
            @PurchaseView.BuyerStatus(context, Clock.GetUtcNow())
            @if (PurchaseView.IsPaid(context))
            {
                <div class="mud-text-secondary">@UiFormat.LocalTime(context.PaidAtMs) UTC</div>
            }
        </MudTd>
        <MudTd>
            @if (PurchaseView.IsPaid(context))
            {
                <MudButton Variant="Variant.Outlined" Size="Size.Small" Href="@($"/me/purchases/{context.SettlementId}/receipt")">Receipt</MudButton>
            }
            else if (PurchaseView.CanPay(context, Clock.GetUtcNow()))
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Href="@($"/me/purchases/{context.SettlementId}/pay")"
                           id="@($"pay-{context.SettlementId}")">Pay</MudButton>
            }
        </MudTd>
    </RowTemplate>
    <NoRecordsContent><MudText>You have not won an auction yet.</MudText></NoRecordsContent>
</MudTable>

@code {
    private IReadOnlyList<SettlementRow> _rows = [];
    private bool _loading = true;
    private UiError? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _rows = (await Bidding.ListMyPurchasesAsync(new ListMyPurchasesRequest { PageSize = 100 })).Rows.ToList();
        }
        catch (Grpc.Core.RpcException ex)
        {
            _error = UiError.From(ex);
        }
        finally
        {
            _loading = false;
        }
    }
}

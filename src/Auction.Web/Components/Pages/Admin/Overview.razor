@page "/admin"
@attribute [Authorize(Roles = "Admin")]
@implements IDisposable
@using Auction.Web.Services.Admin
@using Auction.Web.Services.Ui
@inject AdminService.AdminServiceClient Admin

@* Spec 06 task 9 and spec 08 task 7 and 8 (R5.1, R5.2): system tiles and health every 2 s, the last 15 minutes
   of bids per second in a chart, and the simulator panel. *@
<PageTitle>Admin · Auction</PageTitle>

<AdminNav Current="overview" />

@if (_error != null)
{
    <MudAlert Severity="Severity.Error" Class="mb-3">@_error.Text</MudAlert>
}

<MudPaper Outlined="true" Class="pa-2 mb-4 d-flex flex-wrap gap-2" id="health-strip">
    @if (_system == null)
    {
        <MudChip T="string" Color="Color.Error">Api down</MudChip>
    }
    else
    {
        @foreach (var s in _system.Services)
        {
            <MudChip T="string" Color="@(s.Healthy == s.Total ? Color.Success : s.Healthy == 0 ? Color.Error : Color.Warning)"
                     Icon="@(s.Healthy == s.Total ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Warning)">@s.Service @s.Healthy/@s.Total</MudChip>
        }

        @if (_system.Services.Count == 0)
        {
            <MudChip T="string" Color="Color.Default">No health checks set up</MudChip>
        }

        <MudChip T="string" Icon="@Icons.Material.Filled.Schedule" Color="@(string.IsNullOrEmpty(_stats?.LifecycleLeader) ? Color.Warning : Color.Success)">
            Lifecycle leader: @(string.IsNullOrEmpty(_stats?.LifecycleLeader) ? "none" : _stats.LifecycleLeader)
        </MudChip>
    }
</MudPaper>

<MudGrid Class="mb-4" id="stat-tiles">
    @foreach (var (label, value, icon, id) in Tiles)
    {
        <MudItem xs="6" md="3">
            <MudPaper Outlined="true" Class="pa-4" id="@id">
                <MudStack Row="true" AlignItems="AlignItems.Center">
                    <MudIcon Icon="@icon" Color="Color.Primary" />
                    <MudText Typo="Typo.h5">@value</MudText>
                </MudStack>
                <MudText Typo="Typo.caption">@label</MudText>
            </MudPaper>
        </MudItem>
    }
</MudGrid>

<MudPaper Outlined="true" Class="pa-4 mb-4">
    <MudText Typo="Typo.subtitle1">Bids per second (last 15 minutes)</MudText>
    <MudChart ChartType="ChartType.Line" ChartSeries="_series" XAxisLabels="_labels" Width="100%" Height="240px" id="bids-chart" />
</MudPaper>

<SimulatorPanel />

@code {
    private const int KeepSeconds = 15 * 60;

    private AdminStats? _stats;
    private SystemStats? _system;
    private UiError? _error;
    private readonly Queue<(DateTime At, double Bids)> _history = new();
    private List<ChartSeries> _series = [new() { Name = "Bids/s", Data = new double[2] }];
    private string[] _labels = [];
    private PeriodicTimer? _timer;
    private readonly CancellationTokenSource _stop = new();

    private IEnumerable<(string Label, string Value, string Icon, string Id)> Tiles =>
    [
        ("Bids per second", Rate(_system?.BidsPerSec), Icons.Material.Filled.TrendingUp, "tile-bids"),
        ("Live auctions", Num(_system?.LiveAuctions ?? _stats?.LiveAuctions), Icons.Material.Filled.Gavel, "tile-live"),
        ("Online users", Num(_system?.OnlineUsers), Icons.Material.Filled.People, "tile-online"),
        ("Persist lag", Ms(_system?.PersistLagMs), Icons.Material.Filled.Storage, "tile-lag"),
        ("Error rate", Percent(_system?.ErrorRate * 100), Icons.Material.Filled.ErrorOutline, "tile-errors"),
        ("P99 bid latency", Ms(_system?.P99BidLatencyMs), Icons.Material.Filled.Speed, "tile-p99"),
        ("Redis memory", _system == null ? "-" : _system.RedisMemoryPct >= 0 ? $"{_system.RedisMemoryPct:0.#} %" : Bytes(_system.RedisMemoryBytes), Icons.Material.Filled.Memory, "tile-redis"),
        ("Replicas", _system == null || _system.RedisReplicas < 0 ? "-" : _system.RedisReplicas == 0 ? "none" : $"{_system.RedisReplicas} connected", Icons.Material.Filled.CopyAll, "tile-replicas"),
        ("Scheduled", Num(_stats?.ScheduledAuctions), Icons.Material.Filled.Event, "tile-scheduled"),
        ("Waiting to settle", Num(_stats?.SealedAuctions), Icons.Material.Filled.HourglassTop, "tile-sealed"),
        ("Frozen", Num(_stats?.FrozenAuctions), Icons.Material.Filled.AcUnit, "tile-frozen"),
        ("Users", Num(_stats?.Users), Icons.Material.Filled.PeopleOutline, "tile-users"),
    ];

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
        _ = RefreshLoopAsync();
    }

    private async Task RefreshLoopAsync()
    {
        try
        {
            while (await _timer!.WaitForNextTickAsync(_stop.Token))
            {
                await InvokeAsync(async () =>
                {
                    await LoadAsync();
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task LoadAsync()
    {
        try
        {
            var stats = Admin.GetStatsAsync(new GetStatsRequest(), cancellationToken: _stop.Token).ResponseAsync;
            var system = Admin.GetSystemStatsAsync(new GetSystemStatsRequest(), cancellationToken: _stop.Token).ResponseAsync;
            _stats = await stats;
            _system = await system;
            _error = null;
            AddPoint(_system.BidsPerSec);
        }
        catch (Grpc.Core.RpcException ex)
        {
            _stats = null;
            _system = null;
            _error = UiError.From(ex);
        }
    }

    private void AddPoint(double bidsPerSec)
    {
        _history.Enqueue((DateTime.Now, Math.Max(0, bidsPerSec)));
        while (_history.Count > KeepSeconds / 2)
        {
            _history.Dequeue();
        }

        var points = _history.ToArray();
        _series = [new ChartSeries { Name = "Bids/s", Data = points.Select(p => p.Bids).ToArray() }];
        _labels = points.Select((p, i) => i % 30 == 0 ? p.At.ToString("HH:mm") : "").ToArray();
    }

    private static string Num(int? value) => value is null or < 0 ? "-" : value.Value.ToString("N0");

    private static string Rate(double? value) => value is null or < 0 ? "-" : value.Value.ToString("0.#");

    private static string Ms(double? value) => value is null or < 0 ? "-" : $"{value.Value:0.#} ms";

    private static string Percent(double? value) => value is null or < 0 ? "-" : $"{value.Value:0.##} %";

    private static string Bytes(long value) => value <= 0 ? "-" : $"{value / 1048576.0:0.#} MB";

    public void Dispose()
    {
        _stop.Cancel();
        _timer?.Dispose();
    }
}

<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Small YARP reverse proxy in front of web-1..3 with cookie session affinity. -->
  <ItemGroup>
    <PackageReference Include="Yarp.ReverseProxy" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="yarp.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
